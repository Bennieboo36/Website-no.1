<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Endangered Species | Bennett's Awareness Page</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Source+Sans+3:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>

    <!-- HERO -->
    <header class="hero">
      <div class="hero-overlay"></div>
      <nav class="nav">
        <span class="nav-logo">🌊 Endangered Species</span>
        <ul class="nav-links">
          <li><a href="#species">Species</a></li>
          <li><a href="#facts">Did You Know?</a></li>
          <li><a href="#act">Take Action</a></li>

        </ul>
      </nav>
      <div class="hero-content">
        <p class="hero-eyebrow">Bennett's Awareness Project</p>
        <h1 class="hero-title">Every Species<br><em>Matters.</em></h1>
        <p class="hero-sub">Millions of animals are on the brink of extinction. Learn about them, share their stories, and help bring them back.</p>
        <a href="#species" class="btn-primary">Meet the Species ↓</a>
      </div>
      <div class="wave-divider">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#0f2a3f"/></svg>
      </div>
    </header>

    <!-- INTRO -->
    <section class="intro" id="facts">
      <div class="container">
        <div class="intro-grid">
          <div class="stat-card">
            <span class="stat-num">1M+</span>
            <span class="stat-label">Species threatened with extinction</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">1,000×</span>
            <span class="stat-label">Current extinction rate vs. natural background rate</span>
          </div>
          <div class="stat-card">
            <span class="stat-num">41%</span>
            <span class="stat-label">Of amphibian species are threatened</span>
          </div>
        </div>
        <p class="intro-text">Welcome to Bennett's endangered species page. She is working to spread awareness about the species currently at risk — because understanding them is the first step toward saving them.</p>
      </div>
    </section>

    <!-- SPECIES FLIP CARDS -->
    <section class="species-section" id="species">
      <div class="container">
        <h2 class="section-title">Meet the Species</h2>
        <p class="section-sub">Click any card to reveal facts about each animal</p>

        <div class="cards-grid">

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="snow_leopard.jpg" alt="Snow Leopard">
                <div class="card-label">Snow Leopard</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🐆</div>
                <h3>Snow Leopard</h3>
                <p class="status vulnerable">Vulnerable</p>
                <ul>
                  <li>Only ~4,000 remain in the wild</li>
                  <li>Found in Central Asian mountains</li>
                  <li>Can leap up to 50 feet horizontally</li>
                  <li>Threatened by poaching & habitat loss</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/snow-leopard" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="vaquita.jpg" alt="Vaquita">
                <div class="card-label">Vaquita</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🐬</div>
                <h3>Vaquita</h3>
                <p class="status critical">Critically Endangered</p>
                <ul>
                  <li>Fewer than 10 remain — rarest marine mammal</li>
                  <li>Found only in the Gulf of California</li>
                  <li>About 5 feet long, with dark eye rings</li>
                  <li>Dying due to illegal fishing nets</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/vaquita" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="sumatran_elephant.jpg" alt="Sumatran Elephant">
                <div class="card-label">Sumatran Elephant</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🐘</div>
                <h3>Sumatran Elephant</h3>
                <p class="status critical">Critically Endangered</p>
                <ul>
                  <li>Population dropped 50% in one generation</li>
                  <li>Smallest Asian elephant subspecies</li>
                  <li>Crucial seed dispersers for forests</li>
                  <li>Threatened by deforestation & conflict</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/sumatran-elephant" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="moutnain_gorilla.jpg" alt="Mountain Gorilla">
                <div class="card-label">Mountain Gorilla</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🦍</div>
                <h3>Mountain Gorilla</h3>
                <p class="status endangered">Endangered</p>
                <ul>
                  <li>About 1,000 remain in the wild</li>
                  <li>Share ~98% DNA with humans</li>
                  <li>Live in family groups led by silverbacks</li>
                  <li>Conservation efforts are slowly helping</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/mountain-gorilla" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="javan_rhino.jpg" alt="Javan Rhino">
                <div class="card-label">Javan Rhino</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🦏</div>
                <h3>Javan Rhino</h3>
                <p class="status critical">Critically Endangered</p>
                <ul>
                  <li>Only ~76 individuals left on Earth</li>
                  <li>Survive only in Ujung Kulon, Indonesia</li>
                  <li>One of the rarest large mammals</li>
                  <li>Heavily poached for their horns</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/javan-rhino" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

          <div class="flip-card">
            <div class="flip-inner">
              <div class="flip-front">
                <img src="amur_leopard.jpg" alt="Amur Leopard">
                <div class="card-label">Amur Leopard</div>
              </div>
              <div class="flip-back">
                <div class="back-icon">🐾</div>
                <h3>Amur Leopard</h3>
                <p class="status critical">Critically Endangered</p>
                <ul>
                  <li>Fewer than 100 left in the wild</li>
                  <li>Native to Russian Far East & China</li>
                  <li>Can run up to 37 mph</li>
                  <li>Threatened by poaching & habitat loss</li>
                </ul>
                <a href="https://www.worldwildlife.org/species/amur-leopard" target="_blank" class="learn-link">Learn more →</a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- TAKE ACTION -->
    <section class="action-section" id="act">
      <div class="container">
        <h2 class="section-title light">You Can Make a Difference</h2>
        <p class="section-sub light">Small actions add up to massive change</p>
        <div class="action-grid">
          <div class="action-card">
            <span class="action-icon">📢</span>
            <h3>Spread the Word</h3>
            <p>Share what you've learned. Awareness is the first step toward action.</p>
          </div>
          <div class="action-card">
            <span class="action-icon">💚</span>
            <h3>Support WWF</h3>
            <p><a href="https://www.worldwildlife.org" target="_blank">worldwildlife.org</a> — donate or adopt a species symbolically.</p>
          </div>
          <div class="action-card">
            <span class="action-icon">🌿</span>
            <h3>Choose Sustainably</h3>
            <p>Buy sustainable products and reduce your environmental footprint.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <p>Made with 💙 by Bennett &nbsp;|&nbsp; Endangered Species Awareness Project</p>
      <p class="footer-sub">Thank you for reading — please help spread the word!</p>
    </footer>

  </body>
</html>
